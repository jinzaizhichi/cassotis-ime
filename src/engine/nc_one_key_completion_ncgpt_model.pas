    features[index] := common_prefix;
    features[index + 1] := common_suffix;
    features[index + 2] := text_length_delta;
    features[index + 3] := pinyin_length_delta;
    features[index + 4] := Ord(same_source);
    features[index + 5] := Ord(base_to_transition);
